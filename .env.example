# QDay Aevum Testnet Configuration
AEVUM_RPC_URL=https://rpc-test.qday.info
AEVUM_CHAIN_ID=44005
AEVUM_EXPLORER_URL=https://explorer-test.qday.info

# Official / Recon-verified Testnet tUSD8 token (6 decimals)
TUSD8_ADDRESS=0x456569838f1d43009A91ebA4263147Afd7233483

# Private Keys (Hex encoded with or without 0x prefix)
# Deployer / Vault Owner key (requires tQDAY testnet gas from https://faucet.qday.info)
PRIVATE_KEY=
# Relayer key (requires tQDAY testnet gas to pay for agent transactions)
RELAYER_PRIVATE_KEY=

# Deployed Contract Addresses (populated automatically by scripts/deploy.py)
KAKORO_ACCOUNT_ADDRESS=
PAYEE_REGISTRY_ADDRESS=

# Optional: Port configuration for microservices
CONSOLE_PORT=8000
SELLER_PORT=8001
RELAYER_PORT=8002
